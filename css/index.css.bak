/* ══ RESET & VARS ══ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
img{max-width:100%;height:auto}
:root{
  --navy:#0a1f44;--blue-mid:#1a4a8a;--blue:#2563be;--blue-lt:#4a90d9;
  --sky:#dbeafe;--sky-pale:#eff6ff;
  --gold:#c9a227;--gold-lt:#f5e0a0;
  --purple:#7c3aed;--pink:#db2777;--cyan:#0891b2;--green:#16a34a;--red:#dc2626;
  --bg:#f8fafc;--surface:#ffffff;--surface2:#f1f5f9;--surface3:#e8eef5;
  --border:#e2e8f0;--border2:#cbd5e1;
  --text:#1e293b;--text2:#475569;--text3:#94a3b8;
  --shadow:0 1px 6px rgba(10,31,68,.08),0 4px 20px rgba(10,31,68,.05);
  --shadow-lg:0 4px 24px rgba(10,31,68,.13),0 1px 4px rgba(10,31,68,.07);
  --font-s:'Libre Baskerville',Georgia,serif;
  --font-b:'DM Sans',system-ui,sans-serif;
  --r:12px;--hh:60px;
}
[data-theme="dark"]{
  --bg:#0f172a;--surface:#1e293b;--surface2:#263348;--surface3:#2d3f58;
  --border:#2d3f58;--border2:#374f6b;
  --text:#e2eaf8;--text2:#94a3b8;--text3:#64748b;
  --shadow:0 1px 6px rgba(0,0,0,.3),0 4px 20px rgba(0,0,0,.2);
  --shadow-lg:0 4px 24px rgba(0,0,0,.4);
}
html{overflow-x:hidden}
body{font-family:var(--font-b);background:var(--bg);color:var(--text);line-height:1.5;display:flex;flex-direction:column;min-height:100vh;width:100%;overflow-x:hidden;position:relative}
main{flex:1;width:100%;overflow-x:hidden}
a{color:inherit}
button{font-family:var(--font-b);cursor:pointer;border:none;background:none}
input,select,textarea{font-family:var(--font-b);font-size:.875rem;width:100%;padding:8px 11px;border:1px solid var(--border2);border-radius:8px;background:var(--surface);color:var(--text);outline:none;transition:border-color .15s}
input:focus,select:focus,textarea:focus{border-color:var(--blue)}
label{display:block;font-size:.75rem;font-weight:600;color:var(--text2);margin-bottom:5px}

/* ══ BUTTONS ══ */
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;font-size:.84rem;font-weight:600;cursor:pointer;border:none;transition:opacity .15s,box-shadow .15s;font-family:var(--font-b)}
.btn:hover{opacity:.88}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn-primary{background:var(--blue);color:#fff}
.btn-ghost{background:transparent;border:1px solid var(--border2);color:var(--text2)}
.btn-ghost:hover{background:var(--surface2)}
.btn-success{background:var(--green);color:#fff}
.btn-danger{background:var(--red);color:#fff}
.btn-gold{background:var(--gold);color:var(--navy)}
.btn-sm{padding:5px 12px;font-size:.78rem}

/* ══ HEADER ══ */
header{background:linear-gradient(135deg,var(--navy) 0%,var(--blue-mid) 60%,var(--blue) 100%);color:#fff;position:sticky;top:0;z-index:400;box-shadow:0 2px 16px rgba(10,31,68,.35);overflow:visible}
.hdr{position:relative}
header .hdr{position:relative}
.hdr{max-width:1400px;margin:0 auto;padding:0 16px;height:var(--hh);display:flex;align-items:center;gap:10px}
.hdr-brand{display:flex;align-items:center;gap:10px;flex:1;min-width:0;text-decoration:none;color:#fff;transition:opacity .2s}
.hdr-brand:hover{opacity:.82}
.hdr-title h1{font-family:var(--font-s);font-size:1rem;font-weight:700;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hdr-title p{font-size:.63rem;opacity:.7;letter-spacing:.07em;text-transform:uppercase}
.hdr-right-desktop{display:flex;align-items:center;gap:8px}
@media(max-width:680px){.hdr-right-desktop{display:none}}
.hdr-nav-sep{width:1px;height:22px;background:rgba(255,255,255,.2);margin:0 4px;flex-shrink:0}

/* navbar pills */
.navbar-pill{display:inline-flex;align-items:center;gap:5px;padding:5px 13px;border-radius:20px;
  font-size:12.5px;font-weight:600;cursor:pointer;border:none;font-family:var(--font-b);
  text-decoration:none;transition:opacity .2s,transform .15s;white-space:nowrap}
.navbar-pill:hover{opacity:.88;transform:translateY(-1px)}
.pill-home{background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.25)}
.pill-home:hover{background:rgba(255,255,255,.22)}
.active-pill{background:var(--gold)!important;color:var(--navy)!important;border-color:var(--gold)!important;opacity:1!important}
.active-pill:hover{opacity:.9!important;transform:translateY(-1px)}
.pill-rev{background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.25)}
.pill-rev:hover{background:rgba(255,255,255,.22)}
.pill-login{background:var(--gold);color:var(--navy)}
.pill-login:disabled{opacity:.85;cursor:default;transform:none}

/* icon toggles */
.icon-toggle{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);
  color:rgba(255,255,255,.85);font-size:14px;padding:4px 9px;border-radius:6px;
  cursor:pointer;font-family:var(--font-b);font-weight:600;
  transition:background .2s,color .2s;line-height:1}
.icon-toggle:hover{background:rgba(255,255,255,.2);color:#fff}

/* hamburger */
.hdr-menu-btn{display:none;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);color:#fff;width:44px;height:44px;border-radius:8px;cursor:pointer;align-items:center;justify-content:center;flex-shrink:0}
@media(max-width:680px){.hdr-menu-btn{display:flex}}
.hdr-menu-panel{display:none;position:absolute;top:calc(var(--hh) + 4px);right:12px;width:fit-content;background:var(--navy);border:1px solid rgba(255,255,255,.15);border-radius:10px;box-shadow:0 8px 32px rgba(0,0,0,.4);min-width:220px;z-index:350;overflow:hidden}
.hdr-menu-panel.open{display:block}
.hdr-menu-item{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;font-size:.84rem;color:rgba(255,255,255,.85);border-bottom:1px solid rgba(255,255,255,.08);cursor:pointer;gap:10px}
.hdr-menu-item:last-child{border-bottom:none}
.hdr-menu-item:hover{background:rgba(255,255,255,.08)}
.hdr-menu-label{display:flex;align-items:center;gap:8px}
.hdr-menu-sep{height:1px;background:rgba(255,255,255,.08);margin:4px 0}
.hdr-login-row{padding:10px 12px;display:flex;flex-direction:column;gap:6px}

/* toggle track */
.tog-track{width:29px;height:16px;border-radius:8px;background:rgba(255,255,255,.2);position:relative;flex-shrink:0}
.tog-track.on{background:var(--gold)}
.tog-track .tog-thumb{position:absolute;top:2px;left:2px;width:12px;height:12px;border-radius:50%;background:#fff;transition:left .2s;box-shadow:0 1px 3px rgba(0,0,0,.25)}
.tog-track.on .tog-thumb{left:15px}

html[data-theme] *{transition:filter .12s,opacity .2s,transform .15s!important}

/* ══ ADMIN BAR (identik kalender) ══ */
.admin-bar{background:linear-gradient(90deg,#1a4a8a,#0a1f44);border-bottom:2px solid var(--gold);
  padding:6px 20px;display:none;align-items:center;gap:6px;flex-wrap:nowrap;overflow:hidden;
  position:sticky;top:60px;z-index:250;}
.admin-bar.on{display:flex}
.admin-bar-txt{font-size:.73rem;color:var(--gold-lt);font-weight:500;flex:1;min-width:0;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
@media(max-width:680px){.admin-bar{top:56px;gap:4px;padding:5px 8px;}
  .admin-bar .btn-sm{padding:3px 7px;font-size:.68rem;}}

/* ══ ADMIN DROPDOWN (small — only logout+docs) ══ */
.admin-dd-anchor{position:relative}
.admin-dd{
  display:none;position:absolute;top:calc(100% + 8px);right:0;
  background:rgba(248,250,252,.93);
  backdrop-filter:blur(20px) saturate(170%);-webkit-backdrop-filter:blur(20px) saturate(170%);
  border:1px solid rgba(255,255,255,.7);border-radius:12px;
  box-shadow:0 6px 24px rgba(10,31,68,.18);z-index:500;min-width:180px;overflow:hidden;
  animation:ddIn .16s ease both;
}
[data-theme="dark"] .admin-dd{background:rgba(15,23,42,.88);border:1px solid rgba(255,255,255,.12);box-shadow:0 8px 32px rgba(0,0,0,.5)}
.admin-dd.open{display:block}
@keyframes ddIn{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:translateY(0)}}
.admin-dd-item{display:flex;align-items:center;gap:9px;padding:11px 15px;font-size:.82rem;font-weight:500;color:var(--text);cursor:pointer;transition:background .12s;border:none;background:none;width:100%;text-align:left;font-family:var(--font-b)}
.admin-dd-item:hover{background:var(--surface2)}
.admin-dd-item+.admin-dd-item{border-top:1px solid var(--border)}
.admin-dd-item.danger{color:var(--red)}
.admin-dd-item.danger:hover{background:rgba(220,38,38,.07)}

/* ══ ANNOUNCEMENT BANNER ══ */
.announce-bar{background:linear-gradient(90deg,var(--gold),#e8b520);padding:10px 52px 10px 20px;
  display:none;align-items:center;gap:10px;flex-wrap:wrap;position:relative;z-index:200}
.announce-bar.on{display:flex}
.announce-icon{font-size:18px;flex-shrink:0}
.announce-content{flex:1;min-width:200px}
.announce-title{font-size:.82rem;font-weight:700;color:var(--navy);line-height:1.3}
.announce-sub{font-size:.72rem;color:rgba(10,31,68,.7);margin-top:1px}
.announce-cta{display:inline-flex;align-items:center;gap:5px;background:var(--navy);color:#fff;
  padding:6px 14px;border-radius:20px;font-size:.75rem;font-weight:700;text-decoration:none;
  white-space:nowrap;flex-shrink:0;transition:opacity .15s}
.announce-cta:hover{opacity:.85}
.announce-close{position:absolute;right:10px;top:50%;transform:translateY(-50%);
  background:rgba(10,31,68,.12);border:none;font-size:15px;cursor:pointer;color:rgba(10,31,68,.6);
  padding:0;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;z-index:5}
.announce-close:hover{background:rgba(10,31,68,.22);color:var(--navy)}

/* ══ HERO ══ */
.hero{background:linear-gradient(160deg,var(--navy) 0%,var(--blue-mid) 55%,#1e5fa8 100%);padding:36px 20px 30px;text-align:center;position:relative;overflow:hidden}
.hero-watermark{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;opacity:.11;will-change:transform}
.hero-cross{display:flex;justify-content:center;margin-bottom:12px;filter:drop-shadow(0 0 18px rgba(201,162,39,.45))}
.hero-title{font-family:var(--font-s);font-size:clamp(18px,3.5vw,26px);font-weight:700;color:#fff;letter-spacing:.01em;line-height:1.25;margin-bottom:8px}
.hero-sub{font-size:12.5px;color:rgba(255,255,255,.5);line-height:1.7;max-width:360px;margin:0 auto 18px}
.hero-tags{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;position:relative;padding:0 8px;max-width:100%;box-sizing:border-box}
.hero-tag{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:20px;padding:4px 14px;font-size:11.5px;color:rgba(255,255,255,.7);cursor:pointer;position:relative}
.hero-tag:hover{background:rgba(255,255,255,.14);color:#fff}
.hero-tag-tip{display:none;position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);background:#1f2937;color:#fff;font-size:11px;line-height:1.5;padding:8px 12px;border-radius:8px;white-space:normal;box-shadow:0 4px 16px rgba(0,0,0,.3);z-index:10;text-align:center;pointer-events:none;min-width:120px;max-width:200px}
.hero-tag-tip::after{content:'';position:absolute;top:100%;left:50%;transform:translateX(-50%);border:5px solid transparent;border-top-color:#1f2937}
.hero-tag:hover .hero-tag-tip,.hero-tag.tip-open .hero-tag-tip{display:block}

/* ══ MAIN LAYOUT ══ */
.wrap{max-width:1400px;width:100%;margin:0 auto;padding:24px 20px 48px;overflow-x:hidden;box-sizing:border-box}
.sec-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.sec-title{font-family:var(--font-s);font-size:1rem;font-weight:700;color:var(--navy);display:flex;align-items:center;gap:8px}
.sec-title::before{content:'';display:inline-block;width:3px;height:18px;border-radius:2px;background:var(--gold);flex-shrink:0}
[data-theme="dark"] .sec-title{color:var(--gold-lt)}
.sec-link{font-size:12px;color:var(--blue);font-weight:500;white-space:nowrap}

/* ══ EVENT TERDEKAT ══ */
.events-section{margin-bottom:28px;background:linear-gradient(135deg,rgba(37,99,190,.05) 0%,rgba(201,162,39,.04) 100%);border:1px solid rgba(37,99,190,.1);border-radius:16px;padding:20px;overflow:hidden}
.global-search-section{margin-bottom:14px;position:relative}
.global-search-section .homepage-search-wrap{margin-bottom:0;height:42px;border-radius:28px;font-size:.88rem}
#searchDropdown{position:fixed;background:var(--surface);border:1.5px solid var(--border);border-radius:16px;box-shadow:0 8px 32px rgba(0,0,0,.28);z-index:2000;overflow:hidden;max-height:420px;overflow-y:auto}
#searchDropdown .sd-group-title{font-size:.68rem;font-weight:700;letter-spacing:.08em;color:var(--text3);padding:10px 16px 4px;text-transform:uppercase}
#searchDropdown .sd-item{display:flex;align-items:flex-start;gap:10px;padding:9px 16px;cursor:pointer;transition:background .15s;border-bottom:1px solid var(--border2)}
#searchDropdown .sd-item:last-of-type{border-bottom:none}
#searchDropdown .sd-item:hover{background:var(--hover,rgba(37,99,190,.07))}
#searchDropdown .sd-item-title{font-size:.83rem;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#searchDropdown .sd-item-sub{font-size:.72rem;color:var(--text3);margin-top:1px}
#searchDropdown .sd-footer{display:flex;gap:0;border-top:1px solid var(--border2)}
#searchDropdown .sd-footer a{flex:1;text-align:center;padding:9px;font-size:.78rem;font-weight:600;color:var(--blue);text-decoration:none;transition:background .15s}
#searchDropdown .sd-footer a:hover{background:var(--hover,rgba(37,99,190,.07))}
#searchDropdown .sd-footer a+a{border-left:1px solid var(--border2)}
#searchDropdown .sd-empty{padding:20px 16px;text-align:center;font-size:.82rem;color:var(--text3)}
#searchDropdown .sd-loading{padding:16px;text-align:center;font-size:.8rem;color:var(--text3)}
[data-theme="dark"] .events-section{background:linear-gradient(135deg,rgba(37,99,190,.1) 0%,rgba(201,162,39,.06) 100%);border-color:rgba(37,99,190,.2)}
/* ── events-grid: DESKTOP ≥761px=3col | TABLET 561-760px=2col | MOBILE ≤560px=1col horizontal ── */
.events-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
@media(max-width:760px) and (min-width:561px){.events-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}}
@media(max-width:560px){.events-grid{display:flex;flex-direction:column;gap:10px}}

/* card — fixed height, flex column */
.ev-card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--r);
  box-shadow:0 2px 8px rgba(10,31,68,.07),0 1px 3px rgba(10,31,68,.05);
  display:flex;flex-direction:column;
  overflow:hidden;
  transition:transform .22s cubic-bezier(.25,.8,.25,1),box-shadow .22s cubic-bezier(.25,.8,.25,1);
  position:relative;
  height:100%;
  min-width:0;
  max-width:100%;
}
.ev-card:hover{
  transform:translateY(-5px);
  box-shadow:0 12px 32px rgba(10,31,68,.14),0 3px 8px rgba(10,31,68,.09);
}

/* poster area — aspect-ratio 16:9 agar thumbnail tidak terpotong */
.ev-card-img-wrap{
  position:relative;
  width:100%;
  max-width:100%;
  aspect-ratio:16/9;
  height:auto;
  overflow:hidden;
  flex-shrink:0;
  cursor:pointer;
  display:block;
  contain:layout style;
}
.ev-card-img-wrap img,.ev-card-img-wrap .ev-card-poster{
  position:absolute;
  top:0;left:0;
  width:100% !important;
  height:100% !important;
  max-width:100% !important;
  object-fit:cover;
  display:block;
}
@media(max-width:560px){.ev-card-img-wrap{aspect-ratio:16/9;height:auto}}

/* ── MOBILE ≤560px: card horizontal — thumbnail kiri, info kanan ── */
@media(max-width:560px){
  .ev-card{
    flex-direction:row;
    align-items:stretch;
    min-height:unset;
    height:auto;
  }
  .ev-card-img-wrap{
    flex:0 0 120px;
    width:120px;
    aspect-ratio:unset;
    height:auto;
    min-height:110px;
    border-radius:0;
  }
  .ev-card-accent{
    display:none;
  }
  .ev-card-body{
    flex:1;
    padding:10px 12px;
    gap:4px;
    min-width:0;
    justify-content:flex-start;
  }
  .ev-card-top{
    flex-wrap:wrap;
    gap:4px;
  }
  .ev-card-date{
    font-size:10px;
    padding:2px 6px;
  }
  .ev-card-date .day{font-size:12px}
  .ev-card-title{
    font-size:13px;
    font-weight:700;
    line-height:1.3;
    white-space:normal;
  }
  .ev-card-meta{gap:4px;flex-wrap:wrap}
  .ev-cat-badge{font-size:9.5px;padding:2px 7px}
  .ev-card-time{font-size:10px}
  .ev-card-note{
    font-size:11px;
    max-height:2.6em;
    padding-top:5px;
    margin-top:4px;
  }
  .ev-countdown{font-size:9px;padding:1px 6px}
  .ev-card-admin{gap:2px}
  .ev-card-edit-btn,.ev-card-unfeature-btn{font-size:10px;padding:2px 5px}
}
.ev-card-img-wrap:hover .ev-card-img-overlay{opacity:1}
.ev-card-img-overlay{
  position:absolute;inset:0;
  background:rgba(10,20,40,.45);
  display:flex;align-items:center;justify-content:center;
  opacity:0;transition:opacity .2s;
  color:#fff;font-size:13px;font-weight:600;gap:6px;
}
.ev-card-poster{
  width:100%;height:100%;
  max-width:100%;
  object-fit:cover;display:block;
  transition:transform .3s ease;
}
.ev-card-img-wrap:hover .ev-card-poster{transform:scale(1.04)}

/* placeholder when no poster */
.ev-card-poster-ph{
  width:100%;height:100%;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:8px;font-size:32px;
  background:linear-gradient(135deg,var(--surface2) 0%,var(--surface3) 100%);
  position:relative;overflow:hidden;
}
.ev-card-poster-ph::before{
  content:'';position:absolute;inset:0;
  background:inherit;opacity:.6;
}
.ev-card-poster-ph-icon{position:relative;z-index:1;font-size:36px;line-height:1}
@media(max-width:560px){.ev-card-poster-ph-icon{font-size:52px}}
.ev-card-poster-ph-label{
  position:relative;z-index:1;
  font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  color:var(--text3);
}

/* accent stripe */
.ev-card-accent{height:3px;flex-shrink:0}

/* body */
.ev-card-body{padding:12px 14px;flex:1;display:flex;flex-direction:column;gap:6px}

/* date row — compact horizontal */
.ev-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;flex-wrap:nowrap;min-width:0}
.ev-card-date{
  display:inline-flex;align-items:center;gap:4px;
  font-size:11px;font-weight:600;color:var(--text3);
  background:var(--surface2);border:0.5px solid var(--border);
  border-radius:6px;padding:3px 8px;flex-shrink:0;
}
.ev-card-date .day{font-family:var(--font-s);font-size:13px;font-weight:700;color:var(--text);line-height:1}
.ev-card-date .sep{opacity:.4}
.ev-card-date .mon{font-weight:600;color:var(--text2);text-transform:uppercase;font-size:10px}
.ev-card-date .yr{opacity:.5;font-size:10px}

.ev-card-admin{display:flex;gap:4px;flex-shrink:0;align-items:flex-start}
.ev-card-edit-btn,.ev-card-unfeature-btn{
  display:none;font-size:11px;padding:3px 7px;border-radius:6px;cursor:pointer;
  align-items:center;gap:3px;transition:background .15s,color .15s;
  border:0.5px solid var(--border);background:var(--surface2);color:var(--text2)
}
.ev-card-edit-btn:hover{background:var(--blue);color:#fff;border-color:var(--blue)}
.ev-card-unfeature-btn{font-size:13px;color:var(--text3)}
.ev-card-unfeature-btn:hover{background:rgba(220,38,38,.1);color:var(--red);border-color:var(--red)}
.ev-card-unfeature-btn.is-pinned{color:var(--gold);border-color:var(--gold);background:rgba(201,162,39,.12)}
.ev-card-unfeature-btn.is-pinned:hover{background:rgba(220,38,38,.1);color:var(--red);border-color:var(--red)}
body.is-admin .ev-card-edit-btn,body.is-admin .ev-card-unfeature-btn{display:inline-flex}

.ev-card-title{font-size:13px;font-weight:700;color:var(--text);line-height:1.35}
.ev-card-meta{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.ev-cat-badge{font-size:10px;font-weight:600;padding:2px 8px;border-radius:20px;color:#fff}
.ev-card-time{font-size:10.5px;color:var(--text3)}

/* note — max 3 lines, clamp */
.ev-card-note{
  font-size:11.5px;color:var(--text2);line-height:1.5;
  border-top:0.5px solid var(--border);padding-top:7px;margin-top:auto;
  word-break:break-word;
  max-height:4.8em;overflow:hidden;position:relative;
}
.ev-card-note::after{
  content:'';position:absolute;bottom:0;right:0;left:0;
  height:1.6em;
  background:linear-gradient(to bottom,transparent,var(--surface));
}
@media(max-width:560px){.ev-card-note{max-height:6em}}
.ev-card-note a{color:var(--blue);text-decoration:underline;font-weight:500}

/* past/finished state */
.ev-card-past .ev-card-title{opacity:.6}
.ev-card-past .ev-card-accent{filter:grayscale(.6)}
.ev-card-past .ev-card-img-wrap{filter:grayscale(.4)}

/* countdown badge */
.ev-countdown{display:inline-flex;align-items:center;font-size:9.5px;font-weight:700;padding:2px 7px;border-radius:20px;background:rgba(37,99,190,.1);color:var(--blue);border:0.5px solid rgba(37,99,190,.2);letter-spacing:.01em;width:fit-content}
.ev-countdown-today{background:rgba(201,162,39,.12);color:var(--gold);border-color:rgba(201,162,39,.3)}

.ev-empty{grid-column:1/-1;padding:40px 20px;color:var(--text3);font-size:.82rem;text-align:center;font-style:italic}
.ev-edit-row{display:flex;gap:10px;flex-wrap:wrap}
.ev-edit-row .form-g{flex:1;min-width:130px}

/* ══ POSTER MODAL ══ */
.poster-overlay{
  position:fixed;inset:0;
  background:rgba(5,10,20,.88);
  backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  z-index:700;display:none;
  align-items:center;justify-content:center;
  padding:16px;
  animation:pmFadeIn .2s ease both;
}
.poster-overlay.on{display:flex}
@keyframes pmFadeIn{from{opacity:0}to{opacity:1}}
.poster-modal{
  background:var(--surface);
  border-radius:16px;
  box-shadow:0 24px 64px rgba(0,0,0,.5);
  display:flex;
  width:100%;
  max-width:900px;
  max-height:92vh;
  overflow:hidden;
  animation:pmSlideIn .22s cubic-bezier(.25,.8,.25,1) both;
}
@keyframes pmSlideIn{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:scale(1)}}
.poster-modal-img{
  flex:0 0 55%;
  background:#000;
  display:flex;align-items:center;justify-content:center;
  overflow:hidden;
  position:relative;
}
.poster-modal-img img{
  width:100%;height:100%;
  object-fit:contain;display:block;
}
.poster-modal-info{
  flex:1;
  display:flex;flex-direction:column;
  overflow-y:auto;
  padding:24px 22px;
  gap:14px;
}
.pm-close{
  position:absolute;top:14px;right:14px;
  background:rgba(0,0,0,.55);border:none;
  color:#fff;width:44px;height:44px;border-radius:50%;
  font-size:16px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:background .15s;z-index:10;
}
.pm-close:hover{background:rgba(0,0,0,.8)}
/* desktop: close btn di pojok kanan atas poster-modal (bukan img wrap) */
.poster-modal{position:relative}
.pm-close-desktop{position:absolute;top:14px;right:14px;z-index:20}
.pm-extra{display:flex;flex-direction:column;gap:4px;font-size:.81rem;color:var(--text2)}
.pm-note{font-size:.81rem;color:var(--text2);line-height:1.6;border-top:1px solid var(--border);padding-top:12px}

.pm-title{font-family:var(--font-s);font-size:1.1rem;font-weight:700;color:var(--text);line-height:1.3}
.pm-date{font-size:.8rem;color:var(--text3);display:flex;align-items:center;gap:6px}
.pm-meta{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.pm-caption{
  font-size:.82rem;color:var(--text2);line-height:1.7;
  border-top:1px solid var(--border);padding-top:14px;
  white-space:pre-wrap;word-break:break-word;flex:1;
}
.pm-actions{display:flex;gap:8px;padding-top:12px;border-top:1px solid var(--border);flex-wrap:wrap}

/* mobile poster modal */
@media(max-width:640px){
  .pm-close-desktop{display:none}
  .poster-modal{flex-direction:column;max-height:96vh;overflow-y:auto}
  /* poster 9:16 butuh ruang lebih tinggi agar tidak terpotong */
  .poster-modal-img{flex:0 0 auto;height:auto;min-height:240px;max-height:55vh;aspect-ratio:unset}
  .poster-modal-img img{width:100%;height:100%;object-fit:contain}
  .poster-modal-info{padding:14px 16px;gap:10px;flex:unset}
  .pm-title{font-size:.9rem}
  .pm-caption{font-size:.8rem;max-height:none;overflow:visible}
  .poster-overlay{padding:8px;align-items:flex-start;overflow-y:auto}
}

/* ══ RECAP CAROUSEL ══ */
.recap-section{margin-bottom:24px}
.recap-carousel-wrap{position:relative}
.recap-carousel{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;padding-bottom:4px}
.recap-carousel::-webkit-scrollbar{height:4px}
.recap-carousel::-webkit-scrollbar-track{background:var(--surface2);border-radius:2px}
.recap-carousel::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}
.recap-carousel::-webkit-scrollbar-thumb:hover{background:var(--text3)}
.recap-card{scroll-snap-align:start;flex:0 0 calc(33.33% - 10px);min-width:240px;border-radius:var(--r);overflow:hidden;position:relative;min-height:170px;display:flex;flex-direction:column;justify-content:flex-end;cursor:pointer;transition:transform .2s,box-shadow .2s}
@media(max-width:760px){.recap-card{flex:0 0 calc(50% - 7px)}}
@media(max-width:560px){.recap-card{flex:0 0 78%;min-height:150px}}
@media(max-width:380px){.recap-card{flex:0 0 88%}}
.recap-card:hover{transform:translateY(-3px);box-shadow:0 8px 32px rgba(0,0,0,.18)}
.recap-overlay{position:absolute;inset:0;opacity:.65}
.recap-gradient{position:absolute;inset:0;background:linear-gradient(to top,rgba(10,31,68,.94) 0%,rgba(10,31,68,.1) 65%,transparent 100%)}
.recap-content{position:relative;z-index:1;padding:12px 14px}
.recap-tag{display:inline-block;font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:rgba(255,255,255,.8);margin-bottom:5px;background:rgba(255,255,255,.12);padding:2px 8px;border-radius:20px;border:1px solid rgba(255,255,255,.2)}
.recap-title{font-family:var(--font-s);font-size:14px;font-weight:700;color:#fff;line-height:1.3;margin-bottom:3px}
.recap-meta{font-size:11px;color:rgba(255,255,255,.6)}
.recap-nav{display:flex;gap:6px;justify-content:flex-end;margin-top:10px}
.recap-nav-btn{width:30px;height:30px;border-radius:50%;border:1px solid var(--border2);background:var(--surface);color:var(--text2);font-size:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;flex-shrink:0}
.recap-nav-btn:hover{background:var(--blue);color:#fff;border-color:var(--blue)}
@media(max-width:560px){.recap-nav-btn{width:36px;height:36px;font-size:16px}}

/* ══ BOTTOM ROW (Dokumen + Hubungi Kami) ══ */
.bottom-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;align-items:start}
@media(max-width:640px){.bottom-row{grid-template-columns:1fr}}

.doc-section{}
.doc-grid{display:flex;flex-direction:column;gap:8px}
.doc-card{background:var(--surface);border:0.5px solid var(--border);border-radius:10px;padding:11px 14px;display:flex;align-items:center;gap:10px;cursor:pointer;transition:box-shadow .15s,border-color .15s}
.doc-card:hover{box-shadow:var(--shadow);border-color:var(--blue)}
.doc-icon{width:34px;height:34px;border-radius:8px;background:var(--sky-pale);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.doc-info{flex:1;min-width:0}
.doc-title{font-size:12.5px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.doc-meta{font-size:10.5px;color:var(--text3);margin-top:2px}
.doc-empty{color:var(--text3);font-size:.82rem;font-style:italic}

.contact-section{}
.contact-wrap{background:var(--surface);border:0.5px solid var(--border);border-radius:var(--r);box-shadow:var(--shadow);overflow:visible}
.contact-row{display:flex;align-items:center;gap:14px;padding:13px 18px;cursor:pointer;transition:background .15s;text-decoration:none;color:var(--text);border-bottom:0.5px solid var(--border)}
.contact-row:last-child{border-bottom:none}
.contact-row:hover{background:var(--surface2)}
.contact-icon{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.c-ig{background:linear-gradient(135deg,#f9ce34,#ee2a7b,#6228d7);color:#fff}
.c-yt{background:#ff0000;color:#fff}
.c-tt{background:#010101;color:#fff}
.contact-info{flex:1}
.contact-label{display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text3);margin-bottom:2px}
.contact-handle{display:block;font-size:13px;font-weight:600;color:var(--text)}
.contact-arrow{font-size:14px;color:var(--text3);transition:transform .25s}

/* ══ MODAL ══ */
.overlay{position:fixed;inset:0;background:rgba(10,20,40,.55);backdrop-filter:blur(4px);z-index:600;display:none;align-items:center;justify-content:center;padding:16px}
.overlay.on{display:flex}
.modal{background:var(--surface);border-radius:14px;box-shadow:var(--shadow-lg);width:100%;overflow:hidden;max-height:95vh;display:flex;flex-direction:column}
.modal-hdr{background:linear-gradient(135deg,var(--navy),var(--blue-mid));padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.modal-hdr h2{font-family:var(--font-s);font-size:.9rem;color:#fff;font-weight:700}
.modal-x{background:rgba(255,255,255,.15);border:none;width:28px;height:28px;border-radius:50%;font-size:14px;cursor:pointer;color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.modal-x:hover{background:rgba(255,255,255,.25)}
.modal-body{padding:18px 20px;overflow-y:auto;flex:1}
.modal-foot{display:flex;justify-content:flex-end;gap:8px;padding:14px 20px;border-top:1px solid var(--border);flex-shrink:0}
.doc-frame{width:100%;flex:1;border:none}
.form-g{margin-bottom:14px}
.pw-wrap{position:relative}
.pw-wrap input{padding-right:36px}
.pw-eye{position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text3);padding:4px;display:flex;align-items:center}
.pw-eye:hover{color:var(--text)}
.login-err{display:none;color:var(--red);font-size:.78rem;margin-top:6px}
.check-row{display:flex;align-items:center;gap:8px;padding:8px 0;cursor:pointer}
.check-row input[type=checkbox]{width:auto;cursor:pointer;accent-color:var(--gold)}
.check-row span{font-size:.84rem;font-weight:600;color:var(--text)}

/* doc admin in modal */
.dfg{margin-bottom:10px}
.drow{display:flex;gap:10px}
@media(max-width:500px){.drow{flex-direction:column}}
.doc-adm-list{margin-top:10px;max-height:200px;overflow-y:auto}
.doc-adm-item{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:0.5px solid var(--border)}
.doc-adm-item:last-child{border-bottom:none}
.doc-adm-info{flex:1;min-width:0}
.doc-adm-title{font-size:12px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.doc-adm-meta{font-size:10.5px;color:var(--text3)}
.doc-del{background:none;border:none;color:var(--text3);font-size:18px;cursor:pointer;line-height:1;padding:0 8px;flex-shrink:0;min-width:44px;min-height:44px;display:flex;align-items:center;justify-content:center;}
.doc-del:hover{color:var(--red)}

/* announce admin */
.ann-form{display:flex;flex-direction:column;gap:12px}

/* btn-danger-ghost */
.btn-danger-ghost{background:transparent;border:1px solid var(--red);color:var(--red)}
.btn-danger-ghost:hover{background:rgba(220,38,38,.07)}
.btn-danger-ghost:disabled{opacity:.35;pointer-events:none}

/* ann status row */
.ann-status-row{display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--surface2);border-radius:8px;border:1px solid var(--border)}
.ann-status-dot{width:9px;height:9px;border-radius:50%;background:var(--border2);flex-shrink:0;transition:background .2s}
.ann-status-dot.active{background:#16a34a;box-shadow:0 0 0 3px rgba(22,163,74,.2)}
.ann-status-lbl{font-size:.82rem;color:var(--text2);flex:1}
.ann-toggle-btn{padding:4px 12px;font-size:.75rem;flex-shrink:0}

/* ann preview */
.ann-preview-wrap{border-radius:10px;overflow:hidden;border:1px solid var(--border2)}
.ann-preview-label{font-size:.72rem;color:var(--text3);padding:6px 10px 4px;background:var(--surface2);border-bottom:1px solid var(--border);font-weight:600;letter-spacing:.04em;text-transform:uppercase}
.ann-preview{background:linear-gradient(90deg,var(--gold),#e8b520);padding:9px 14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.ann-preview .announce-icon{font-size:1.1rem;flex-shrink:0}
.ann-preview .announce-content{flex:1;min-width:0}
.ann-preview .announce-title{font-size:.82rem;font-weight:700;color:var(--navy);line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ann-preview .announce-sub{font-size:.72rem;color:rgba(10,31,68,.7);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ann-preview .announce-cta{font-size:.75rem;font-weight:700;color:var(--navy);background:rgba(10,31,68,.12);padding:4px 10px;border-radius:20px;white-space:nowrap;text-decoration:none;flex-shrink:0}

/* ══ FOOTER ══ */
footer{background:var(--navy);color:rgba(255,255,255,.4);text-align:center;padding:12px 16px;font-size:.7rem;line-height:1.9;position:relative;z-index:1}
footer strong{color:rgba(255,255,255,.75)}

/* ══ TOAST ══ */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);background:#1e293b;color:#fff;padding:9px 20px;border-radius:20px;font-size:.82rem;font-weight:500;opacity:0;transition:opacity .25s,transform .25s;pointer-events:none;z-index:999;white-space:nowrap}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
.toast.ok{background:#16a34a}
.toast.err{background:var(--red)}

/* ══ ANIMATIONS & SCROLL REVEAL ══ */
@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes scaleIn{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:scale(1)}}

/* Staggered entrance — hero loads instantly */
.anim-1{animation:fadeUp .55s .04s ease both}
.anim-2{animation:fadeUp .55s .12s ease both}
.anim-3{animation:fadeUp .55s .2s ease both}
.anim-4{animation:fadeUp .55s .28s ease both}

/* Scroll-triggered reveal — animasi CSS sebagai base, observer sebagai enhancement */
.reveal{opacity:0;transform:translateY(16px);transition:opacity .5s ease,transform .5s ease}
.reveal.visible{opacity:1;transform:translateY(0)}
/* Fallback: kalau observer tidak jalan dalam 1.5s, paksa visible via animasi */
.reveal{animation:revealFallback 0s 1.5s forwards}
@keyframes revealFallback{to{opacity:1;transform:translateY(0)}}
.reveal.visible{animation:none}
.reveal-delay-1{transition-delay:.05s}
.reveal-delay-2{transition-delay:.12s}
.reveal-delay-3{transition-delay:.2s}

/* Event card entrance stagger — animasi via CSS, tidak bergantung pada IntersectionObserver */
.ev-card{
  animation:evCardIn .45s ease both;
  transition:box-shadow .22s,border-color .2s,transform .22s cubic-bezier(.25,.8,.25,1);
}
@keyframes evCardIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.ev-card:nth-child(1){animation-delay:.04s}
.ev-card:nth-child(2){animation-delay:.1s}
.ev-card:nth-child(3){animation-delay:.16s}
.ev-card:nth-child(4){animation-delay:.22s}
.ev-card:nth-child(5){animation-delay:.28s}
.ev-card:nth-child(6){animation-delay:.34s}
.ev-card:hover{transform:translateY(-4px);box-shadow:0 10px 28px rgba(10,31,68,.13)}
[data-theme="dark"] .ev-card:hover{box-shadow:0 10px 28px rgba(0,0,0,.35)}

/* ══ RECAP DOTS ══ */
.recap-bottom-row{display:flex;align-items:center;gap:12px;margin-top:12px}
.recap-progress-track{flex:1;height:3px;border-radius:2px;background:var(--border2);overflow:hidden}
.recap-progress-bar{height:100%;border-radius:2px;background:var(--gold);transition:width .25s ease}

/* ══ HERO TAGS — tooltip on hover ══ */
.hero-tag{position:relative}
.hero-tag::after{
  content:attr(data-tip);
  position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);
  background:var(--navy);color:#fff;
  font-size:10px;font-weight:500;white-space:nowrap;
  padding:4px 10px;border-radius:6px;
  opacity:0;pointer-events:none;transition:opacity .2s;
  box-shadow:0 4px 12px rgba(0,0,0,.25);
}
.hero-tag[data-tip]:hover::after{opacity:1}

/* ══ POSTER MODAL — mobile improved ══ */
@media(max-width:640px){
  .poster-overlay{padding:0;align-items:flex-end;background:rgba(5,10,20,.75)}
  .poster-modal{
    flex-direction:column;
    width:100%;max-width:100%;
    border-radius:20px 20px 0 0;
    max-height:94vh;
    overflow-y:auto;
    animation:pmSlideUp .28s cubic-bezier(.25,.8,.25,1) both;
  }
  @keyframes pmSlideUp{from{transform:translateY(40px);opacity:0}to{transform:translateY(0);opacity:1}}
  .poster-modal-img{
    flex:0 0 auto;
    width:100%;
    height:min(56vw,280px);
    border-radius:0;
  }
  .poster-modal-img img{width:100%;height:100%;object-fit:contain}
  .pm-close{top:10px;right:10px}
  .poster-modal-info{padding:16px 18px 32px;gap:10px;flex:unset}
  .pm-title{font-size:1rem}
  .pm-caption{font-size:.81rem;max-height:none;overflow:visible}
  .pm-actions{flex-wrap:wrap}
  .pm-actions .btn{flex:1;justify-content:center;min-width:120px}
}

/* ══ SHARE BUTTON ══ */
.btn-outline{background:transparent;border:1.5px solid var(--border2);color:var(--text2)}
.btn-outline:hover{background:var(--surface2);border-color:var(--blue);color:var(--blue)}
@media(max-width:680px){
  .events-section{padding:14px 12px}
  .bottom-row{gap:12px}
  .admin-bar{padding:5px 12px;flex-wrap:wrap}
  .admin-bar-txt{font-size:.68rem}
  .announce-bar{padding:8px 52px 8px 12px;gap:6px;flex-wrap:nowrap}
  .announce-icon{font-size:15px;display:none}
  .announce-content{min-width:0;flex:1}
  .announce-cta{padding:5px 10px;font-size:.7rem;flex-shrink:0;max-width:38vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .announce-close{right:6px;width:32px;height:32px;font-size:13px;top:50%;transform:translateY(-50%)}
  .hdr-menu-panel{z-index:500}
  .admin-dd{right:-4px;width:200px}
  .wrap{padding:16px 14px 40px}
  .sec-hdr{margin-bottom:10px}
}
@media(max-width:560px){
  .ev-card-body{padding:10px 12px;gap:5px}
  .ev-card-title{font-size:13px}
  .ev-cat-badge{font-size:9.5px}
  .ev-card-time{font-size:10px}
  .poster-modal{flex-direction:column;max-height:96vh;border-radius:12px}
  .poster-modal-img{flex:0 0 52vw;max-height:52vw}
  .poster-modal-info{padding:14px 16px;gap:10px}
  .pm-title{font-size:.9rem}
  .pm-caption{font-size:.78rem}
}
@media(max-width:380px){
  .events-section{padding:10px}
  .ev-card-date{font-size:9.5px}
  .ev-card-title{font-size:12.5px}
}

/* social media expand arrow rotate */
.contact-sm-row.open .contact-arrow{transform:rotate(180deg)}

/* ══ PULL TO REFRESH ══ */
.ptr-spinner{position:fixed;top:64px;left:50%;transform:translateX(-50%) translateY(-80px);z-index:500;display:flex;align-items:center;gap:8px;background:var(--card);color:var(--text);border-radius:20px;padding:7px 16px 7px 12px;font-size:.8rem;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,.15);transition:transform .3s cubic-bezier(.34,1.56,.64,1),opacity .3s;opacity:0;pointer-events:none}
.ptr-spinner.ptr-visible{transform:translateX(-50%) translateY(0);opacity:1}
.ptr-spinner svg{animation:ptr-spin .8s linear infinite}
@keyframes ptr-spin{to{transform:rotate(360deg)}}

/* ══ FEEDBACK BUTTON ══ */
.feedback-fab{position:fixed;bottom:24px;right:20px;z-index:998;display:flex;align-items:center;gap:7px;background:rgba(var(--blue-rgb,30,90,200),.55);color:#fff;border:none;border-radius:24px;padding:10px 16px 10px 13px;font-size:.8rem;font-weight:600;font-family:inherit;cursor:pointer;box-shadow:0 4px 18px rgba(10,31,68,.2);transition:background .18s,transform .18s,box-shadow .18s,opacity .18s;white-space:nowrap;backdrop-filter:blur(6px)}
.feedback-fab:hover{background:var(--blue);transform:translateY(-2px);box-shadow:0 8px 24px rgba(10,31,68,.45)}
.feedback-fab svg{flex-shrink:0}

/* ══════════════════════════════════════════
   SESI 34 — ADDITIONS
   Items: 1,2,3,4,6,7,8,9,10,11
   ══════════════════════════════════════════ */

/* ── Item 3: Confirm Modal ── */
/* Reuses existing .overlay + .modal classes — no extra CSS needed */
/* confirmCancelBtn / confirmOkBtn use existing .btn classes */

/* ── Item 7: Empty State ── */
.ev-empty-state{
  grid-column:1/-1;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:48px 20px;text-align:center;gap:10px;
}
.ev-empty-state-icon{font-size:2.8rem;line-height:1;opacity:.6}
.ev-empty-state-title{font-size:.92rem;font-weight:700;color:var(--text2)}
.ev-empty-state-sub{font-size:.8rem;color:var(--text3);line-height:1.5;max-width:280px}

/* ── Item 8: Skeleton Loader ── */
@keyframes shimmer{
  0%{background-position:-400px 0}
  100%{background-position:400px 0}
}
.sk-card{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r);
  overflow:hidden;display:flex;flex-direction:column;min-height:220px;
}
.sk-img{
  width:100%;aspect-ratio:16/9;
  background:linear-gradient(90deg,var(--surface2) 25%,var(--surface3) 50%,var(--surface2) 75%);
  background-size:800px 100%;
  animation:shimmer 1.4s infinite linear;
}
.sk-body{padding:12px 14px;display:flex;flex-direction:column;gap:9px;flex:1}
.sk-line{
  border-radius:4px;
  background:linear-gradient(90deg,var(--surface2) 25%,var(--surface3) 50%,var(--surface2) 75%);
  background-size:800px 100%;
  animation:shimmer 1.4s infinite linear;
}
.sk-line-sm{height:10px;width:55%}
.sk-line-md{height:13px;width:80%}
.sk-line-lg{height:13px;width:95%}
.sk-line-xs{height:9px;width:40%}

/* ── Item 9: Scroll to Top ── */
.scroll-top-btn{
  position:fixed;bottom:72px;left:20px;z-index:997;
  width:40px;height:40px;border-radius:50%;
  background:var(--blue);color:#fff;
  border:none;cursor:pointer;font-size:16px;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 4px 14px rgba(10,31,68,.25);
  opacity:0;pointer-events:none;
  transition:opacity .25s,transform .25s;
  transform:translateY(8px);
}
.scroll-top-btn.visible{opacity:1;pointer-events:auto;transform:translateY(0)}
.scroll-top-btn:hover{background:var(--blue-mid);transform:translateY(-2px)}

/* ── Item 10: Card fade-in animation — staggered ── */
/* Already handled by existing evCardIn + nth-child rules */
/* For re-renders triggered by data load, we rely on JS adding class */
.ev-card.card-animate{animation:evCardIn .4s ease both}

/* ── Item 11: A11Y — Tap targets ── */
@media(max-width:680px){
  .recap-nav-btn{min-width:44px;min-height:44px}
  .ev-card-edit-btn,.ev-card-unfeature-btn{min-width:44px;min-height:44px;padding:0 8px}
  /* Fix 8: Pastikan tombol pin tidak meluber keluar card, bintang center vertikal */
  .ev-card-admin{max-width:50%;gap:2px;align-items:center}
  .announce-close{min-width:44px;min-height:44px;right:4px}
  .modal-x{min-width:44px;min-height:44px}
  .ev-card-img-wrap{min-height:44px}
  .icon-toggle{min-height:44px;padding:0 12px}
}
/* Desktop small buttons — extend hit area via pseudo */
.ev-card-edit-btn::before,.ev-card-unfeature-btn::before{
  content:'';position:absolute;inset:-6px;
}
.ev-card-edit-btn,.ev-card-unfeature-btn{position:relative}

/* ══════════════════════════════════════════
   SESI 35 — BOTTOM NAVIGATION BAR (MOBILE)
   ══════════════════════════════════════════ */

/* ── Bottom Nav — hanya tampil mobile ≤680px ── */
.bottom-nav{
  display:none;
  position:fixed;bottom:0;left:0;right:0;
  height:60px;
  background:var(--navy);
  border-top:1px solid rgba(255,255,255,.12);
  z-index:450;
  align-items:stretch;
  box-shadow:0 -4px 20px rgba(0,0,0,.25);
  /* Safe area untuk iPhone home bar */
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media(max-width:680px){
  .bottom-nav{display:flex}
  /* Sembunyikan hamburger — digantikan bottom nav */
  .hdr-menu-btn{display:none!important}
  /* Geser elemen fixed agar tidak bertabrakan dengan bottom nav */
  .toast{bottom:calc(70px + env(safe-area-inset-bottom,0px))!important}
  /* Feedback fab di mobile: tampilkan kecil di kiri atas bottom-nav, hanya icon */
  .feedback-fab{
    display:flex!important;
    bottom:calc(68px + env(safe-area-inset-bottom,0px));
    right:12px;
    padding:8px 10px;
    font-size:.75rem;
    border-radius:20px;
    background:rgba(var(--blue-rgb,30,90,200),.7);
    box-shadow:0 2px 10px rgba(10,31,68,.3);
  }
  .feedback-fab .fab-txt{display:none} /* Sembunyikan teks, tampilkan hanya icon */
  /* Scroll-to-top di kiri, di atas FAB */
  .scroll-top-btn{bottom:calc(120px + env(safe-area-inset-bottom,0px))!important;left:12px;right:auto}
  /* Body padding cukup untuk bottom-nav + sedikit breathing room */
  body{padding-bottom:calc(72px + env(safe-area-inset-bottom,0px))}
}

/* ── Tab item ── */
.bn-tab{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:2px;background:none;border:none;cursor:pointer;
  color:rgba(255,255,255,.5);text-decoration:none;
  font-family:var(--font-b);padding:6px 4px;
  transition:color .18s;
  min-height:44px;
  -webkit-tap-highlight-color:transparent;
}
.bn-tab:hover,.bn-tab:focus-visible{color:rgba(255,255,255,.85);outline:none}
.bn-tab--active{color:#fff}
.bn-tab--active .bn-icon{
  transform:scale(1.1);
}
.bn-icon{font-size:1.25rem;line-height:1;transition:transform .18s}
.bn-label{font-size:.6rem;font-weight:600;letter-spacing:.02em;line-height:1;margin-top:1px}

/* Indikator aktif — dot kecil di atas icon */
.bn-tab--active::before{
  content:'';display:block;
  width:4px;height:4px;border-radius:50%;
  background:var(--gold);
  position:absolute;top:6px;left:50%;transform:translateX(-50%);
}
.bn-tab{position:relative}

/* ── Action Sheet Overlay ── */
.bn-sheet-overlay{
  display:none;position:fixed;inset:0;
  background:rgba(0,0,0,.45);
  z-index:449;
  backdrop-filter:blur(2px);
  -webkit-backdrop-filter:blur(2px);
}
.bn-sheet-overlay.open{display:block}

/* ── Action Sheet Panel ── */
.bn-sheet{
  display:block;
  position:fixed;bottom:-100%;left:0;right:0;
  background:var(--navy);
  border-top:1px solid rgba(255,255,255,.15);
  border-radius:16px 16px 0 0;
  z-index:451;
  padding:8px 0 calc(12px + env(safe-area-inset-bottom,0px));
  transition:bottom .28s cubic-bezier(.4,0,.2,1);
  box-shadow:0 -8px 32px rgba(0,0,0,.35);
}
.bn-sheet.open{bottom:60px}

/* Handle drag visual */
.bn-sheet-handle{
  width:36px;height:4px;border-radius:2px;
  background:rgba(255,255,255,.25);
  margin:0 auto 12px;
}

/* Sheet item — bisa div atau button */
.bn-sheet-item{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 20px;
  font-size:.88rem;color:rgba(255,255,255,.85);
  font-family:var(--font-b);font-weight:500;
  width:100%;background:none;border:none;cursor:pointer;
  text-align:left;gap:10px;
  transition:background .15s;
  min-height:44px;
}
.bn-sheet-item:hover,.bn-sheet-item:active{background:rgba(255,255,255,.07)}

/* Actions (tombol saja, tanpa toggle) */
.bn-sheet-action{justify-content:flex-start;gap:8px}
.bn-sheet-login{color:var(--gold-lt);font-weight:600}
.bn-sheet-danger{color:#fca5a5}

/* Admin name display */
.bn-sheet-admin-name{
  font-size:.75rem;color:var(--gold-lt);
  text-align:center;padding:6px 20px 2px;
  font-weight:600;
}

/* Separator */
.bn-sheet-sep{
  height:1px;background:rgba(255,255,255,.1);
  margin:4px 0;
}

/* ══ [Sesi 40 Item 3] Widget Renungan Terbaru ══ */
.rev-widget-section{margin-bottom:32px}
.rev-widget-card{display:flex;gap:16px;background:var(--card);border-radius:14px;overflow:hidden;border:1px solid var(--border);transition:box-shadow .2s,transform .2s}
.rev-widget-card:hover{box-shadow:0 4px 24px rgba(0,0,0,.18);transform:translateY(-2px)}
.rev-widget-img-wrap{flex-shrink:0;width:130px;height:130px;overflow:hidden;background:var(--bg2)}
.rev-widget-img{width:100%;height:100%;object-fit:cover;object-position:top}
.rev-widget-body{padding:14px 16px 14px 0;display:flex;flex-direction:column;gap:6px;justify-content:center}
.rev-widget-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.rev-widget-title{font-size:1rem;font-weight:700;color:var(--text1);line-height:1.3}
.rev-widget-verse{font-size:12px;color:var(--text2)}
.rev-widget-cta{font-size:12px;color:var(--blue);font-weight:600;text-decoration:none;width:fit-content}
.rev-widget-cta:hover{text-decoration:underline}
@media(max-width:480px){
  .rev-widget-img-wrap{width:90px;height:90px}
  .rev-widget-body{padding:12px 12px 12px 0}
  .rev-widget-title{font-size:.9rem}
}
/* ══ [Sesi 40 Item 2] Badge kategori clickable ══ */
.ev-cat-badge{transition:opacity .15s}
.ev-cat-badge:hover{opacity:.82}

/* ══ SESI 43: Search beranda ══ */
.homepage-search-wrap{position:relative;display:flex;align-items:center;margin-bottom:14px;background:var(--surface);border:1.5px solid var(--border2);border-radius:24px;padding:0 14px;height:38px;gap:8px;transition:border-color .2s}
.homepage-search-wrap:focus-within{border-color:var(--blue)}
.homepage-search-icon{opacity:.4;flex-shrink:0;pointer-events:none}
.homepage-search-wrap input{flex:1;border:none;background:transparent;color:var(--text);font-family:var(--font-b);font-size:.84rem;outline:none}
.homepage-search-wrap input::placeholder{color:var(--text3)}

/* ══ SESI 43: Banner dinamis multi-row ══ */
#bannerContainer .announce-bar{display:flex;align-items:center;gap:10px;padding:9px 16px;min-height:44px;transition:background .2s}
.announce-bar.on,.announce-bar{display:flex}

/* ══ SESI 43: Draft badge di ev-card beranda ══ */
.ev-card-draft{opacity:.75}
.ev-draft-badge{position:absolute;top:8px;left:8px;font-size:9px;font-weight:800;letter-spacing:.08em;padding:2px 8px;border-radius:20px;background:rgba(245,158,11,.85);color:#fff;z-index:2;backdrop-filter:blur(4px)}
.ev-card{position:relative}

/* ══ SESI 43: Galeri di poster modal ══ */
#pmGallery{padding:12px 0 0}
.pm-gallery-title{font-size:.72rem;font-weight:700;color:var(--text3);letter-spacing:.08em;margin-bottom:8px}
.pm-gallery-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
.pm-gallery-item{border-radius:10px;overflow:hidden}
.pm-gallery-item img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;border-radius:8px;background:var(--bg2)}
.pm-gallery-cap{font-size:10px;color:var(--text3);text-align:center;margin-top:3px}

/* ══════════════════════════════════════════════════════════════
   PANDUAN ZONA RESPONSIVE — baca sebelum edit CSS apapun
   ══════════════════════════════════════════════════════════════
   DESKTOP  : min-width: 761px  → grid 3 kolom, card vertikal
   TABLET   : 561px–760px       → grid 2 kolom, card vertikal
   MOBILE   : max-width: 560px  → flex column, card HORIZONTAL
   SMALL    : max-width: 380px  → padding lebih kecil

   ATURAN:
   - Edit layout desktop? Gunakan (min-width:761px) atau tanpa media query (base)
   - Edit layout mobile?  Gunakan (max-width:560px) — JANGAN tanpa min-width
   - Edit keduanya?       Tulis dua blok terpisah, jangan disingkat
   ══════════════════════════════════════════════════════════════ */

/* ══ BIRTHDAY CARD ══ */
.ev-card-bday{
  border:2px solid rgba(201,162,39,.45);
  background:linear-gradient(160deg,var(--surface) 70%,rgba(201,162,39,.06));
}
.ev-card-bday-today{
  border-color:rgba(201,162,39,.8);
  box-shadow:0 0 0 3px rgba(201,162,39,.15),0 8px 32px rgba(201,162,39,.12);
}
.ev-card-bday-name{
  font-size:.88rem;font-weight:800;color:#c9a227;
  letter-spacing:.02em;margin-bottom:2px;
}
.ev-countdown-bday{
  display:inline-flex;align-items:center;gap:4px;
  font-size:10px;font-weight:800;padding:2px 9px;border-radius:20px;
  background:linear-gradient(135deg,rgba(201,162,39,.2),rgba(234,179,8,.25));
  color:#b45309;border:1px solid rgba(201,162,39,.4);
}

/* Shimmer efek untuk card birthday hari ini */
.ev-bday-shimmer{
  position:absolute;inset:0;border-radius:inherit;pointer-events:none;overflow:hidden;z-index:0;
}
.ev-bday-shimmer::after{
  content:'';position:absolute;top:0;left:-100%;width:60%;height:100%;
  background:linear-gradient(90deg,transparent,rgba(201,162,39,.18),transparent);
  animation:bdayShimmer 2.4s ease-in-out infinite;
}
@keyframes bdayShimmer{
  0%{left:-100%}
  60%,100%{left:140%}
}

/* ══ BIRTHDAY MODAL ══ */
.bday-overlay .modal{position:relative;padding:0}
.bday-modal-header{
  background:linear-gradient(135deg,#0a1f44 0%,#1e3a6e 100%);
  padding:28px 24px 20px;
  border-radius:var(--radius) var(--radius) 0 0;
}
.bday-emoji-row{font-size:1.8rem;margin-bottom:10px;letter-spacing:4px}
.bday-modal-title{
  font-family:var(--font-b);font-size:1.5rem;font-weight:800;
  color:#c9a227;margin-bottom:4px;
}
.bday-modal-sub{font-size:.78rem;color:rgba(255,255,255,.65)}

.bday-person{display:flex;flex-direction:column;align-items:center;gap:12px;width:100%}
/* Foto bebas — proporsional, tidak di-crop, portrait/landscape sama-sama aman */
.bday-foto-free{
  width:100%;display:flex;justify-content:center;
  background:rgba(0,0,0,.06);border-radius:12px;overflow:hidden;
}
.bday-foto-img{
  max-width:100%;max-height:300px;
  width:auto;height:auto;
  object-fit:contain;object-position:top center;display:block;border-radius:10px;
}
.bday-foto-placeholder{
  font-size:4rem;padding:24px;
  background:linear-gradient(135deg,rgba(10,31,68,.08),rgba(201,162,39,.1));
  border-radius:12px;width:100%;text-align:center;
}
.bday-name{
  font-size:1.25rem;font-weight:800;color:var(--text);
  font-family:var(--font-b);letter-spacing:.01em;
}
